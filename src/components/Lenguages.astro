---
import { getI18N } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const { LENGUAGES } = i18n;
---

<button
    class="cursor-pointer hover:bg-gray-700 p-2 rounded-lg relative"
    id="lenguages"
>
    <img src="/assets/icons/lenguage.svg" alt="Language Icon" />
    <ul class="lenguages_list bg-gray-700 rounded-lg p-3" id="lenguages_list">
        {
            LENGUAGES.map(({ title, lang }) => {
                return (
                    <li class="cursor-pointer hover:bg-gray-500 p-2 rounded-lg whitespace-nowrap">
                        <a href={`/${lang}/`}>{title}</a>
                    </li>
                );
            })
        }
    </ul>
</button>

<style>
    .lenguages_list {
        position: absolute;
        visibility: hidden;
        opacity: 0;
        transform: translateX(-20px) translateY(-10px);
        transition:
            transform 0.2s ease-in-out,
            opacity 0.2s ease-in-out,
            visibility 0s linear 0.2s;
    }

    .lenguages_list::before {
        content: "";
        position: absolute;
        z-index: -1;
        top: -10px; /* Ajusta la flecha para que se alinee mejor */
        left: 16px; /* Asegura que la flecha esté centrada */
        width: 0;
        height: 0;
        border-left: 13px solid transparent;
        border-right: 13px solid transparent;
        border-bottom: 13px solid #374151; /* Color de la flecha */
    }

    .lenguages_list_open {
        visibility: visible;
        opacity: 1;
        transform: translateX(-20px) translateY(20px);
        transition:
            transform 0.2s ease-in-out,
            opacity 0.2s ease-in-out,
            visibility 0s linear 0s;
    }
</style>

<script>
    const $lenguages = document.getElementById("lenguages");
    const $lenguages_list = document.getElementById("lenguages_list");
    $lenguages?.addEventListener("click", () => {
        $lenguages_list?.classList.toggle("lenguages_list_open");
    });
</script>
